# Know Thyself AI Backend Configuration

# Database (defaults to SQLite if not provided, or PostgreSQL connection string)
DATABASE_URL=sqlite:///./know_thyself.db
# DATABASE_URL=postgresql://user:password@hostname:5432/know_thyself

# Security Secrets
JWT_SECRET=know-thyself-super-secure-jwt-secret-key-2026-hackathon
ENVIRONMENT=development

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
# If omitted, application automatically falls back to the deterministic Python analytics rule engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS
FRONTEND_ORIGIN=http://localhost:5173
